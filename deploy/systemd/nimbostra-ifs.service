# Download the latest published ECMWF IFS 0.1° run (open data), then convert it to Zarr.
# Both steps are no-ops when nothing new is published. No credentials needed;
# ECMWF_SOURCES in .env may reorder the mirrors (default aws,ecmwf).
# Paths and user are defaults: adapt them (see docs/exploitation.md).
[Unit]
Description=Nimbostra: IFS ingestion (ECMWF open data -> Zarr)
Wants=network-online.target
After=network-online.target
OnFailure=nimbostra-alert@%n.service

[Service]
Type=oneshot
User=nimbostra
Group=nimbostra
WorkingDirectory=/opt/nimbostra/src
EnvironmentFile=/opt/nimbostra/.env
ExecStart=/opt/nimbostra/.venv/bin/python -m ingest.ecmwf_fetch fetch --keep 2
ExecStart=/opt/nimbostra/.venv/bin/python -m ingest.mf_paquets_convert convert --model ifs --keep 2
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
# One global 0.1° field decoded at a time (3600 x 1801), the cropped run is small.
MemoryMax=3G
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data/raw /data/zarr

[Install]
WantedBy=multi-user.target
