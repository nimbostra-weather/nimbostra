# Public API, listening on localhost only: Caddy is the front door.
[Unit]
Description=Nimbostra: HTTP API (uvicorn)
After=network.target

[Service]
User=nimbostra
Group=nimbostra
WorkingDirectory=/opt/nimbostra/src
EnvironmentFile=/opt/nimbostra/.env
ExecStart=/opt/nimbostra/.venv/bin/uvicorn api.app:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/data/zarr

[Install]
WantedBy=multi-user.target
