# Download the latest complete AROME 0.01° run, then convert it to Zarr.
# Both steps are no-ops when nothing new is published.
# Paths and user are defaults: adapt them (see docs/exploitation.md).
[Unit]
Description=Nimbostra: AROME ingestion (API Paquets -> Zarr)
Wants=network-online.target
After=network-online.target
OnFailure=nimbostra-alert@%n.service

[Service]
Type=oneshot
User=nimbostra
Group=nimbostra
WorkingDirectory=/opt/nimbostra/src
EnvironmentFile=/opt/nimbostra/.env
ExecStart=/opt/nimbostra/.venv/bin/python -m ingest.arome_fetch fetch --keep 2
ExecStart=/opt/nimbostra/.venv/bin/python -m ingest.arome_convert convert --keep 2
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
# The conversion holds one run in memory (~6 GB).
MemoryMax=12G
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data/raw /data/zarr

[Install]
WantedBy=multi-user.target
