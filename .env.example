ENV=dev
# Météo-France : l'un ou l'autre (Application ID prioritaire, jeton renouvelé automatiquement)
METEOFRANCE_APPLICATION_ID=
METEOFRANCE_API_KEY=
RAW_DIR=/data/raw
DATA_DIR=/data/zarr
POSTGRES_DSN=postgresql://nimbostra:change-me@localhost:5432/nimbostra
REDIS_URL=redis://localhost:6379/0
# Alertes (docs/exploitation.md) : POST texte vers cette adresse, vide = journal seulement
ALERT_WEBHOOK_URL=
ALERT_MAX_AGE_HOURS=12
